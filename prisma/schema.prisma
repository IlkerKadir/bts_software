generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model Role {
  id                 String   @id @default(cuid())
  name               String   @unique
  canViewCosts       Boolean  @default(false)
  canApprove         Boolean  @default(false)
  canExport          Boolean  @default(true)
  canManageUsers     Boolean  @default(false)
  /// Separate admin capability for configuration: commercial term
  /// templates, price label options, quote defaults, etc. Kept distinct
  /// from `canManageUsers` so a config curator can exist without full
  /// user/role admin rights.
  canManageSettings  Boolean  @default(false)
  canEditProducts    Boolean  @default(false)
  /// `canDelete` covers quotes (drafts only), companies, projects, and
  /// other operational records. Product-catalog deletes are gated by a
  /// separate flag — `canDeleteProducts` — so a salesperson can clean
  /// up their own drafts/companies/projects without ever being able to
  /// remove a product from the master catalog.
  canDelete          Boolean  @default(false)
  canDeleteProducts  Boolean  @default(false)
  canOverrideKatsayi Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
  visibleProjects    Project[] @relation("ProjectVisibleToRole")
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  passwordHash   String
  fullName       String
  email          String?
  roleId         String
  role           Role            @relation(fields: [roleId], references: [id])
  isActive       Boolean         @default(true)
  /// Soft-delete marker. Non-null = admin deleted the user. The row stays
  /// so foreign keys on quotes / orders / price history keep resolving;
  /// every listing query filters `deletedAt: null` so the user is invisible.
  deletedAt      DateTime?
  lastLogin      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quotes         Quote[]              @relation("CreatedBy")
  approvedQuotes Quote[]              @relation("ApprovedBy")
  lastEditedQuotes Quote[]            @relation("LastEditedBy")
  notifications  Notification[]
  quoteHistory   QuoteHistory[]
  documents      QuoteDocument[]
  orders         OrderConfirmation[]  @relation("OrderCreatedBy")
  reminders      Reminder[]
  projectAccess  ProjectUserAccess[]
  projectsCreated Project[]            @relation("ProjectCreatedBy")
  quoteInteractions QuoteInteraction[]
}

// ==================== COMPANIES ====================

enum CompanyType {
  CLIENT
  PARTNER
  MUTEAHHIT
  SON_KULLANICI
  SOZLESMELI_BAYI
  ENTEGRATOR
  DANISMAN
  PROJE_FIRMASI
  DISTRIBUTOR
  URETICI
}

model Company {
  id           String         @id @default(cuid())
  name         String
  type         CompanyType
  address      String?
  taxNumber    String?        @unique
  phone        String?
  email        String?
  contacts     Json? // Array of {name, title, email, phone}
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects           Project[]
  quotes             Quote[]
  priceHistory       PriceHistory[]
  orderConfirmations OrderConfirmation[]
}

// ==================== PROJECTS ====================

enum ProjectStatus {
  TEKLIF_ASAMASINDA
  ONAYLANDI
  DEVAM_EDIYOR
  TAMAMLANDI
  IPTAL
}

enum ProjectVisibility {
  CREATOR_ONLY
  SPECIFIC_USERS
  EVERYONE
  /// Everyone holding `visibleToRole` (+ managers) sees the project.
  ROLE
}

model Project {
  id             String            @id @default(cuid())
  name           String
  location       String? // Proje Yeri: a Turkish province or "Yurtdışı"
  clientId       String?
  client         Company?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?             @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  status         ProjectStatus     @default(TEKLIF_ASAMASINDA)
  visibility     ProjectVisibility @default(EVERYONE)
  /// Set when visibility == ROLE: the role whose members see the project.
  visibleToRoleId String?
  visibleToRole   Role?            @relation("ProjectVisibleToRole", fields: [visibleToRoleId], references: [id], onDelete: SetNull)
  estimatedStart DateTime?
  estimatedEnd   DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  quotes         Quote[]
  documents      ProjectDocument[]
  activities     ProjectActivity[]
  reminders      Reminder[]
  visibleTo      ProjectUserAccess[]

  @@index([createdById])
  @@index([visibleToRoleId])
}

model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileType   String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  action    String
  note      String
  createdAt DateTime @default(now())
}

model ProjectUserAccess {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// ==================== PRODUCTS ====================

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]
}

model ProductBrand {
  id            String         @id @default(cuid())
  name          String         @unique
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  products      Product[]
  brandDiscount BrandDiscount?
}

enum PricingType {
  LIST_PRICE
  PROJECT_BASED
}

model BrandDiscount {
  id          String       @id @default(cuid())
  brandId     String       @unique
  brand       ProductBrand @relation(fields: [brandId], references: [id])
  coefficient Decimal      @default(1) @db.Decimal(5, 3)
  updatedAt   DateTime     @updatedAt
  updatedById String?
}

model Product {
  id           String           @id @default(cuid())
  code         String           @unique
  shortCode    String?
  brandId      String?
  brand        ProductBrand?    @relation(fields: [brandId], references: [id])
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  model        String?
  name         String
  nameTr       String? // Turkish name if different
  nameEn       String?
  pricingType  PricingType      @default(LIST_PRICE)
  unit         String           @default("Adet")
  listPrice    Decimal          @db.Decimal(12, 2)
  costPrice    Decimal?         @db.Decimal(12, 2)
  currency     String           @default("EUR")
  supplier     String?
  minKatsayi   Decimal?         @db.Decimal(5, 3)
  maxKatsayi   Decimal?         @db.Decimal(5, 3)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  quoteItems   QuoteItem[]
  priceHistory PriceHistory[]
}

// ==================== QUOTES ====================

enum QuoteStatus {
  TASLAK
  ONAY_BEKLIYOR
  /// Approver requested edits on a pending quote. Distinct from
  /// TASLAK so the salesperson sees explicitly that an approver
  /// kicked the quote back, not just that they retracted it. The
  /// creator transitions out via DUZENLEME_TALEP_EDILDI →
  /// ONAY_BEKLIYOR ("yeniden onaya gönder").
  DUZENLEME_TALEP_EDILDI
  ONAYLANDI
  GONDERILDI
  TAKIPTE
  REVIZYON
  KAZANILDI
  KAYBEDILDI
  IPTAL
}

model Quote {
  id              String                @id @default(cuid())
  quoteNumber     String                @unique
  refNo           String?
  projectId       String?
  project         Project?              @relation(fields: [projectId], references: [id])
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subject         String?
  description     String?
  currency        String                @default("EUR")
  exchangeRate    Decimal               @db.Decimal(10, 4)
  protectionPct   Decimal               @default(0) @db.Decimal(5, 2)
  protectionMap   Json                  @default("{}")
  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal               @default(0) @db.Decimal(12, 2)
  discountPct     Decimal               @default(0) @db.Decimal(5, 2)
  /**
   * Optional scope for the quote-level discount. When null, the discount
   * applies to the entire quote subtotal (legacy behavior). When set, it
   * points at a SUBTOTAL QuoteItem and the discount only reduces the sum
   * of priced items in that SUBTOTAL's section (items between the previous
   * SUBTOTAL and this one). Auto-healed to null by the persistence layer
   * if the referenced item is deleted or is no longer a SUBTOTAL.
   */
  discountScopeSubtotalId String?
  vatTotal        Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal               @default(0) @db.Decimal(12, 2)
  status          QuoteStatus           @default(TASLAK)
  validUntil      DateTime?
  validityDays    Int                   @default(30)
  version         Int                   @default(1)
  parentQuoteId   String?
  parentQuote     Quote?                @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions       Quote[]               @relation("QuoteRevisions")
  createdById     String
  createdBy       User                  @relation("CreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?                 @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  /**
   * Tracks the user who pulled an approved quote back to TASLAK via
   * the status dropdown. Independent of `createdById` so the original
   * author isn't overwritten — used by the view page's "Hazırlayan"
   * field to display the most-recent editor when set.
   */
  lastEditedById  String?
  lastEditedBy    User?                 @relation("LastEditedBy", fields: [lastEditedById], references: [id])
  lastEditedAt    DateTime?
  notes           String?
  language        String                @default("TR")
  /** Cosmetic PDF override — stores user-edited HTML from the WYSIWYG PDF editor.
   *  Does NOT mutate the structured quote data. Null if no override set. */
  pdfOverrideHtml String?               @db.Text
  pdfOverrideAt   DateTime?
  /**
   * Frozen rate matrix that was in effect when the quote was last
   * explicitly rated (on create or via the Kurları Güncelle flow).
   * Shape: `{ "EUR": { "TRY": 52.2669, "USD": 1.1689, ... }, ... }`.
   * Loaded on reopen so new items and recalcs stay internally
   * consistent with items that were saved under the same rates. Fresh
   * TCMB is fetched separately in the background so the banner can
   * detect drift and offer an explicit update.
   *
   * Null on quotes created before this field existed — in that case
   * the editor falls back to live TCMB, same as legacy behavior.
   */
  rateSnapshot    Json?
  // ── Teklif Takip (sales tracking) — overwritten on each update ──
  priority          QuotePriority?
  successPct        Int? // Başarı yüzdesi 0–100
  expectedOrderDate DateTime?
  // Set when status = KAYBEDILDI
  lostReason        LostReason?
  lostCompetitor    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items              QuoteItem[]
  documents          QuoteDocument[]
  history            QuoteHistory[]
  commercialTerms    QuoteCommercialTerm[]
  orderConfirmations OrderConfirmation[]
  priceHistories     PriceHistory[]
  ekMaliyetler       QuoteEkMaliyet[]
  reminders          Reminder[]
  interactions       QuoteInteraction[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
}

// ==================== TEKLİF TAKİP (quote tracking) ====================

enum QuotePriority {
  A
  B
  C
  D
}

enum LostReason {
  BUTCE_YETERSIZ // Bütçe Yetersizliği
  RAKIPTEN_PAHALI // Rakipten Pahalı Kalmak
  RAKIP_MARKA_TERCIHI // Rakip Marka Tercihi
  TEKNIK_YETERSIZLIK // Teknik Şartname / Yetersizlik
  PROJE_IPTALI // Proje İptali
  ODEME_KOSULLARI // Ödeme Koşulları
}

enum QuoteInteractionType {
  TELEFON
  EMAIL
  YUZ_YUZE // Yüz Yüze Ziyaret
  ONLINE_TOPLANTI // Online Toplantı
  FUAR
}

/// One row per logged contact in a quote's "İletişim Geçmişi" (cumulative).
model QuoteInteraction {
  id              String               @id @default(cuid())
  quoteId         String
  quote           Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  interactionDate DateTime             @default(now())
  type            QuoteInteractionType
  note            String
  reminderDate    DateTime? // optional follow-up; mirrored into a Reminder
  createdAt       DateTime             @default(now())

  @@index([quoteId])
}

enum QuoteItemType {
  PRODUCT
  HEADER
  NOTE
  CUSTOM
  SET
  SUBTOTAL
  GRAND_TOTAL
}

model QuoteItem {
  id            String        @id @default(cuid())
  quoteId       String
  quote         Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  itemType      QuoteItemType @default(PRODUCT)
  sortOrder     Int           @default(0)
  code          String?
  brand         String?
  model         String?
  description   String
  quantity      Decimal       @default(1) @db.Decimal(10, 2)
  unit          String        @default("Adet")
  listPrice     Decimal       @default(0) @db.Decimal(12, 2)
  katsayi       Decimal       @default(1) @db.Decimal(5, 3)
  unitPrice     Decimal       @default(0) @db.Decimal(12, 2)
  discountPct   Decimal       @default(0) @db.Decimal(5, 2)
  vatRate       Decimal       @default(20) @db.Decimal(5, 2)
  totalPrice    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  /**
   * When set, the row's price column is replaced by this literal label
   * (e.g. "TARAFINIZCA SAĞLANACAKTIR", "FİYATA DAHİLDİR"). The item's
   * unitPrice / totalPrice are treated as 0 in all quote sum calcs.
   */
  priceLabel    String?
  isManualPrice Boolean       @default(false)
  costPrice     Decimal?      @db.Decimal(12, 2)
  /** Per-unit ek maliyet distributed amount. Stored separately from listPrice/costPrice
   *  so the user's original entry is preserved. Displayed & calculated as effective prices
   *  in the UI, but listPrice and costPrice remain untouched in the DB. */
  ekMaliyetDelta Decimal?     @db.Decimal(12, 2)
  serviceMeta   Json?
  /**
   * Optional per-SET currency. NULL means "inherit the quote's currency"
   * (existing behavior). Only SET rows are allowed to carry a non-null
   * value, and the value must be either 'TRY' or the quote's own
   * currency — enforcement lives in the API validation layer. Children
   * of a SET read this off their parent; they do not carry their own.
   */
  currency      String?
  /**
   * Per-section discount percentage (0–100). Only meaningful on
   * SUBTOTAL rows; null/0 means "no discount on this section".
   * Non-SUBTOTAL rows are coerced to null at the API layer.
   * When set, `calculateQuoteTotals` reduces this section's sum by
   * (sectionSum × sectionDiscountPct / 100) before adding into the
   * grand total. Price-labeled rows and children of SETs are still
   * excluded from the section sum, identical to pre-change behavior.
   */
  sectionDiscountPct Decimal?      @db.Decimal(5, 2)
  /**
   * Optional custom label for the section's discount line on PDF/Excel
   * exports — e.g. "İskonto" (default), "Ek İndirim", "Ozel İskonto".
   * Only meaningful on SUBTOTAL rows that carry a non-null
   * sectionDiscountPct. Null → renderers fall back to "İskonto".
   */
  sectionDiscountLabel String?
  parentItemId  String?
  parentItem    QuoteItem?  @relation("ItemSubRows", fields: [parentItemId], references: [id], onDelete: Cascade)
  subRows       QuoteItem[] @relation("ItemSubRows")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([quoteId])
}

/**
 * Admin-managed catalog of fiyat etiketi (price label) options shown in
 * the quote editor's right-click menu. A row stores the literal text
 * that ends up in `QuoteItem.priceLabel`; deleting a row does not
 * cascade — historical quotes keep rendering the exact label text.
 */
model PriceLabelOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteDocument {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  fileType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model QuoteHistory {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // CREATE, UPDATE, STATUS_CHANGE, APPROVE, EXPORT
  changes   Json? // {field: {old, new}}
  createdAt DateTime @default(now())

  @@index([quoteId])
}

// ==================== COMMERCIAL TERMS ====================

model CommercialTermTemplate {
  id        String   @id @default(cuid())
  category  String // payment, delivery, warranty, vat, teslim_yeri
  name      String
  value     String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  highlight Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
}

model QuoteCommercialTerm {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category  String
  value     String
  sortOrder Int     @default(0)
  highlight Boolean @default(false)
}

// ==================== CURRENCY & EXCHANGE ====================

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(12, 6)
  source       String   @default("MANUAL") // TCMB, MANUAL
  isManual     Boolean  @default(false)
  fetchedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, fetchedAt])
  @@index([fromCurrency, toCurrency])
}

// ==================== APPROVAL RULES ====================

enum ApprovalConditionType {
  VALUE_GT // Grand total greater than
  VALUE_LT // Grand total less than
  DISCOUNT_GT // Discount percentage greater than
  KATSAYI_LT // Any katsayi less than
  ALWAYS // Always require approval
}

model ApprovalRule {
  id             String                @id @default(cuid())
  name           String
  conditionType  ApprovalConditionType
  conditionValue Decimal?              @db.Decimal(12, 2)
  requiresRoleId String
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// ==================== PRICE HISTORY ====================

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  unitPrice Decimal  @db.Decimal(12, 2)
  katsayi   Decimal  @db.Decimal(5, 3)
  quantity  Decimal  @db.Decimal(10, 2)
  currency  String
  quotedAt  DateTime @default(now())

  @@index([productId, companyId])
  @@index([productId])
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  APPROVAL_NEEDED
  QUOTE_APPROVED
  QUOTE_REJECTED
  QUOTE_EXPIRING
  FOLLOW_UP_REMINDER
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ==================== SAVED FILTERS ====================

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  entity    String // 'quotes', 'products', 'companies', etc.
  filters   Json // Stores the filter criteria as JSON
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, entity])
  @@index([userId, entity])
}

// ==================== SYSTEM SETTINGS ====================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== QUOTE EK MALIYET ====================

model QuoteEkMaliyet {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title     String
  /**
   * The raw amount the user typed for this cost line, denominated in
   * `sourceCurrency`. For legacy rows (`sourceCurrency = NULL`) this
   * is whatever the user typed in the old modal, which is
   * conventionally TRY. Conversion to the quote currency happens at
   * distribution time via `rateMatrix[sourceCurrency][quote.currency]`.
   */
  amount    Decimal  @db.Decimal(12, 2)
  /**
   * Entry currency for `amount`. New writes stamp this explicitly
   * (default TRY in the modal). Null on rows created before this
   * field existed — those are treated as TRY for backward
   * compatibility with the old modal, which was hardcoded to TRY.
   */
  sourceCurrency String?
  /**
   * Reserved for future use. Kept nullable and unused today — the
   * canonical source-currency value lives on `amount`, and carrying
   * it twice would drift. A later schema cleanup can drop this
   * column if we never find a use for it.
   */
  sourceAmount   Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
}

// ==================== ORDER CONFIRMATIONS ====================

enum OrderStatus {
  TASLAK
  // Legacy values (pre-2026-06-25) — kept so the enum type stays valid for any
  // unmigrated rows; no longer surfaced in the UI. Existing rows were remapped:
  // HAZIRLANIYOR→TASLAK, ONAYLANDI/GONDERILDI→TAMAMLANDI.
  HAZIRLANIYOR
  ONAYLANDI
  GONDERILDI
  TAMAMLANDI
  IPTAL
}

model OrderConfirmation {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id])
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(TASLAK)
  notes         String?
  deliveryDate  DateTime?
  createdById   String
  createdBy     User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Revision chain (STF-####-R#)
  parentOrderId String?
  parentOrder   OrderConfirmation?  @relation("OrderRevisions", fields: [parentOrderId], references: [id])
  revisions     OrderConfirmation[] @relation("OrderRevisions")
  revisionNo    Int                 @default(0)

  // Snapshotted, editable header (all nullable)
  customerName     String?
  customerAddress  String?
  customerPhone    String?
  customerTaxInfo  String?
  projectName      String?
  quoteNo          String?
  refNo            String?
  formDate         DateTime?
  siparisNo        String?
  currency         String    @default("TRY")
  discountTotal    Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal       Decimal   @default(0) @db.Decimal(12, 2)

  // Footer blocks (editable text)
  manufacturers        String?
  warranty             String?
  deliveryPlace        String?
  /// TESLİMAT footer block (delivery timing text, e.g. "Kesin siparişten sonra
  /// 8-10 hafta"). Snapshotted from the quote's `teslimat` commercial term.
  /// Distinct from deliveryDate (a date) and deliveryPlace (location).
  deliveryTime         String?
  paymentTerms         String?
  vatNote              String?
  customerApprovalName String?
  btsResponsibleName   String?
  /// Free-form note ("Serbest Kalem") rendered as a full-width row between the
  /// item table and the footer blocks (above ÜRETİCİ FİRMALAR). Optional —
  /// nothing renders when empty.
  freeNote             String?

  items         OrderItem[]

  @@index([quoteId])
  @@index([companyId])
  @@index([parentOrderId])
}

model OrderItem {
  id           String        @id @default(cuid())
  orderId      String
  order        OrderConfirmation @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortOrder    Int
  itemType     QuoteItemType @default(PRODUCT)
  pozNo        String?
  code         String?
  brand        String?
  model        String?
  description  String        @default("")
  quantity     Decimal       @default(0) @db.Decimal(12, 2)
  unit         String        @default("Adet")
  unitPrice    Decimal       @default(0) @db.Decimal(12, 2)
  totalPrice   Decimal       @default(0) @db.Decimal(12, 2)
  /// Snapshot of the source QuoteItem.currency (per-SET override). NULL means
  /// the row is priced in the STF's own currency. Mirrors the quote PDF:
  /// price cells render in this currency (e.g. ₺) while totals use the
  /// converted amount below.
  currency     String?
  /// `totalPrice` converted into the STF's currency, computed ONCE at
  /// snapshot/revision time with the source quote's base (non-protected)
  /// rate. NULL when the row already sits in the STF currency. Section sums
  /// and GENEL TOPLAM read this in preference to the raw totalPrice.
  totalPriceInOrderCurrency Decimal? @db.Decimal(12, 2)
  priceLabel   String?
  /// Snapshot-only copy of the source QuoteItem's parentItemId (SET grouping).
  /// NOT a live FK to OrderItem — values reference the originating quote items,
  /// kept for fidelity. How sectioned/SET groups render is settled in the PDF
  /// phase; do not add an FK here without remapping these ids first.
  parentItemId String?
  discountPct  Decimal       @default(0) @db.Decimal(5, 2)
  /// Snapshot of the source QuoteItem.sectionDiscountPct. Only meaningful on
  /// SUBTOTAL rows; null/0 = no per-section discount. Hand-editable on the STF.
  sectionDiscountPct   Decimal? @db.Decimal(5, 2)
  /// Snapshot of QuoteItem.sectionDiscountLabel. Custom label for the section
  /// discount line (default "İskonto"). Only meaningful on SUBTOTAL rows.
  sectionDiscountLabel String?
  sectionNote  String?
  createdAt    DateTime      @default(now())

  @@index([orderId])
}

// ==================== REMINDERS ====================

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  note        String?
  dueDate     DateTime
  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isCompleted, dueDate])
  @@index([dueDate, isCompleted])
}
